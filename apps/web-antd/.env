# 应用标题
VITE_APP_TITLE=Neton 开发者平台

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=neton-platform-antd

# 是否开启模拟数据
VITE_NITRO_MOCK=false

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=false

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=true

# 百度统计
VITE_APP_BAIDU_CODE =

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# API 加解密
VITE_APP_API_ENCRYPT_ENABLE = true
VITE_APP_API_ENCRYPT_HEADER = X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM = AES
VITE_APP_API_ENCRYPT_REQUEST_KEY = REPLACE_ME_32_HEX_CHARS_REQUEST_KEY
VITE_APP_API_ENCRYPT_RESPONSE_KEY = REPLACE_ME_32_HEX_CHARS_RESPONSE_KEY

# 百度地图
VITE_BAIDU_MAP_KEY=
